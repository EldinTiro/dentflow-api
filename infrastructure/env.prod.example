# ============================================================
# DentFlow — Production Environment Variables
# Kopiraj u /app/.env na VPS-u i popuni vrijednosti.
# NIKAD ne commituj .env sa pravim vrijednostima!
# ============================================================

# --- PostgreSQL ---
POSTGRES_PASSWORD=zamijeni-jakom-lozinkom

# --- JWT ---
# Minimum 32 karaktera, random string
# Generiši: openssl rand -base64 48
JWT_SIGNING_KEY=zamijeni-random-stringom-minimum-32-karaktera
JWT_ISSUER=https://mydentflow.com
JWT_AUDIENCE=https://mydentflow.com

# --- MinIO (file storage) ---
# Generiši: openssl rand -hex 16
MINIO_ROOT_USER=zamijeni-access-key
MINIO_ROOT_PASSWORD=zamijeni-secret-key-min-8-karaktera

# Javni URL za presigned file linkove
# Format: https://{slug}.mydentflow.com/files  (ili zasebni subdomain kad poraste)
# Za sada postavi na VPS IP dok ne konfiguriše subdomain
STORAGE_PUBLIC_URL=http://POSTAVI_VPS_IP:9000

# --- SuperAdmin (seeda se pri prvom pokretanju) ---
SUPERADMIN_EMAIL=admin@mydentflow.com
SUPERADMIN_PASSWORD=zamijeni-jakom-lozinkom-min-12-karaktera
SUPERADMIN_FIRSTNAME=Super
SUPERADMIN_LASTNAME=Admin
