{
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000",
      "http://localhost:5199"
    ]
  },
  "Finbuckle": {
    "MultiTenant": {
      "Stores": {
        "ConfigurationStore": {
          "Defaults": {
            "ConnectionString": "Host=localhost;Port=5432;Database=dentflow;Username=dentflow;Password=dentflow"
          },
          "Tenants": [
            {
              "Id": "tenant-dev",
              "Identifier": "localhost",
              "Name": "Dev Tenant"
            }
          ]
        }
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft.EntityFrameworkCore.Database.Command": "Information"
      }
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=dentflow;Username=dentflow;Password=dentflow"
  },
  "Redis": {
    "ConnectionString": "localhost:6379"
  },
  "Jwt": {
    "Issuer": "https://mydentflow.com",
    "Audience": "https://mydentflow.com",
    "AccessTokenExpiryMinutes": 60,
    "RefreshTokenExpiryDays": 7
  },
  "SuperAdmin": {
    "FirstName": "Super",
    "LastName": "Admin"
  },
  "Storage": {
    "ServiceUrl": "http://localhost:9000",
    "AccessKey": "dentflow-local",
    "SecretKey": "dentflow-secret",
    "BucketName": "dentflow-files",
    "UsePathStyle": true
  },
  "Notifications": {
    "UseFakeChannel": true
  }
}
